 transition={disabled || reduced ? { duration: 0 } : { duration, ease: 'linear', repeat: Infinity }}\n    >\n      {letters.map((letter, index) => (\n        <span\n          key={index}\n          aria-hidden\n          data-letter\n          className=\"absolute top-1/2 left-1/2 inline-block whitespace-pre\"\n          style={\n            {\n              transform: `translate(-50%, -50%) rotate(${(360 / letters.length) * index}deg) translateY(${-radius}ch)`,\n            } as CSSProperties\n          }\n        >\n          {letter}\n        </span>\n      ))}\n      <span className=\"sr-only\">{text}</span>\n    </motion.div>\n  )\n}\n"}],"usage":"<pre class=\"shiki shiki-themes github-light github-dark-default\" style=\"--shiki-light:#24292e;--shiki-dark:#e6edf3;--shiki-light-bg:#fff;--shiki-dark-bg:#0d1117\" tabindex=\"0\"><code><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> { SpinningText } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\"> '@/components/spinning-text'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">export</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> default</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> function</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#D2A8FF\"> SpinningTextDemo</span><span style=\"--shiki-light:#24292E;--shiki-dark:#FFA657\">() </span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">{</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">  return</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> (</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">    &#x3C;</span><span style=\"--shiki-light:#228