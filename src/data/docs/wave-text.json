<motion.span\n          key={i}\n          aria-hidden\n          className=\"inline-block\"\n          animate={inView ? { y: [0, -amplitude, 0, amplitude * 0.4, 0] } : { y: 0 }}\n          transition={{\n            delay: i * stagger,\n            duration,\n            ease: 'easeInOut',\n            times: [0, 0.25, 0.5, 0.75, 1],\n            repeat: Infinity,\n          }}\n        >\n          {char}\n        </motion.span>\n      ))}\n    </Tag>\n  )\n}\n"}],"usage":"<pre class=\"shiki shiki-themes github-light github-dark-default\" style=\"--shiki-light:#24292e;--shiki-dark:#e6edf3;--shiki-light-bg:#fff;--shiki-dark-bg:#0d1117\" tabindex=\"0\"><code><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> { WaveText } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\"> '@/components/wave-text'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">export</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> default</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> function</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#D2A8FF\"> WaveTextDemo</span><span style=\"--shiki-light:#24292E;--shiki-dark:#FFA657\">() </span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">{</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">  return</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> (</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">    &#x3C;</span><span style=\"--shiki-light:#22863A;--shiki-dark:#7EE787\">div</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#79C0FF\"> className</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">=</span><span style=