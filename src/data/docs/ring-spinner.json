ame?: string\n}\n\nconst SIZE: Record<RingSpinnerSize, string> = {\n  sm: 'size-3 border-[1.5px]',\n  md: 'size-5 border-2',\n  lg: 'size-8 border-[3px]',\n}\n\n/** An indeterminate ring. Under reduced motion it holds still as an open arc. */\nexport function RingSpinner({ size = 'md', label = 'Loading', duration = 0.8, className }: RingSpinnerProps) {\n  const ref = useRef<HTMLSpanElement>(null)\n  const reduced = usePrefersReducedMotion()\n  const inView = useInView(ref)\n  const spinning = !reduced && inView\n\n  return (\n    <span\n      ref={ref}\n      role=\"status\"\n      aria-label={label}\n      className={cn('inline-flex shrink-0 text-foreground', className)}\n    >\n      <motion.span\n        aria-hidden\n        className={cn('inline-block rounded-full border-current/20 border-t-current', SIZE[size])}\n        animate={spinning ? { rotate: 360 } : { rotate: 0 }}\n        transition={spinning ? { duration, ease: 'linear', repeat: Infinity } : { duration: 0 }}\n      />\n    </span>\n  )\n}\n"}],"usage":"<pre class=\"shiki shiki-themes github-light github-dark-default\" style=\"--shiki-light:#24292e;--shiki-dark:#e6edf3;--shiki-light-bg:#fff;--shiki-dark-bg:#0d1117\" tabindex=\"0\"><code><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> { RingSpinner } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\"> '@/components/ring-spinner'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">export</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> default</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> function</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#D2A8FF\"> RingSpinnerDemo</span><span style=\"--shiki-light:#24292E;--shiki-dark:#FFA657\">() </span><span s