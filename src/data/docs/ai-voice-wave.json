ls, bars = 24, active = false, height = 48, label = 'Voice', duration = 0.9, className }: AIVoiceWaveProps) {\n  const reduced = usePrefersReducedMotion()\n  const count = levels ? levels.length : Math.max(1, bars)\n  const heights = Array.from({ length: count }, (_, i) => Math.min(1, Math.max(0.08, levels ? levels[i] : shape(i, count))))\n  const moving = active && !reduced && !levels\n\n  return (\n    <div\n      role=\"img\"\n      aria-label={active ? `${label}: listening` : `${label}: idle`}\n      data-slot=\"ai-voice-wave\"\n      data-active={active}\n      className={cn('flex items-center justify-center gap-[3px]', className)}\n      style={{ height }}\n    >\n      {heights.map((h, i) => (\n        <motion.span\n          key={i}\n          aria-hidden\n          className={cn('block w-[3px] rounded-full', active ? 'bg-primary' : 'bg-muted-foreground/50')}\n          style={{ height, originY: 0.5 }}\n          initial={false}\n          animate={moving ? { scaleY: [h, Math.min(1, h * 0.45 + 0.12), h] } : { scaleY: h }}\n          transition={moving ? { duration, delay: (i % 6) * 0.07, ease: 'easeInOut', repeat: Infinity } : { duration: reduced ? 0 : 0.12, ease: 'easeOut' }}\n        />\n      ))}\n    </div>\n  )\n}\n"}],"usage":"<pre class=\"shiki shiki-themes github-light github-dark-default\" style=\"--shiki-light:#24292e;--shiki-dark:#e6edf3;--shiki-light-bg:#fff;--shiki-dark-bg:#0d1117\" tabindex=\"0\"><code><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> { useState } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\"> 'react'</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> { AIVoiceWave } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#