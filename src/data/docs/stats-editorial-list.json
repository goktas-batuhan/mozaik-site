export interface StatsEditorialListProps {\n  /** Section headline. Labels the section for assistive tech. */\n  title: ReactNode\n  /** Small text above the headline, e.g. \"By the numbers\". */\n  eyebrow?: string\n  /** Stats, one per row. */\n  stats: EditorialStat[]\n  /** Element for the root. */\n  as?: ElementType\n  /** Turns the entrance animation and the count-up off. */\n  disabled?: boolean\n  className?: string\n}\n\n/** Oversized numbers in ruled rows, each with its explanation beside it. Reads like a magazine spread. */\nexport function StatsEditorialList({ title, eyebrow, stats, as: Tag = 'section', disabled = false, className }: StatsEditorialListProps) {\n  const id = useId()\n  const reduced = usePrefersReducedMotion()\n  const animate = !disabled && !reduced\n\n  return (\n    <Tag aria-labelledby={id} className={cn('@container w-full', className)}>\n      {eyebrow != null && <p className=\"text-sm font-medium tracking-wider text-primary uppercase\">{eyebrow}</p>}\n      <h2 id={id} className=\"mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-balance text-foreground @xl:text-4xl\">\n        {title}\n      </h2>\n\n      <ol className=\"mt-10 border-b border-border\">\n        {stats.map((stat, index) => (\n          <motion.li\n            key={stat.label}\n            initial={animate ? { opacity: 0, x: -24 } : false}\n            whileInView={{ opacity: 1, x: 0 }}\n            viewport={{ once: true }}\n            transition={{ duration: 0.55, delay: index * 0.06, ease: [0.22, 1, 0.36, 1] }}\n            className=\"grid items-baseline gap-x-8 gap-y-2 border-t border-border py-8 @2xl:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]\"\n          >\n            <p className=\"flex items-baseline text-6xl font-semibold tracking-tighter text-foreground @2xl:text-7xl\">\n              {stat.prefix}\n              <NumberTicker value={stat.value} decimalPlaces={stat.decimalPlaces} duration={1.6} disabled={disabled} />\n              {stat.suffix != null && <span className=\"text-primary\">{stat.suffix}</span>}\n            </p>\n            <div>\n              <h3 className=\"text-lg font-medium text-foreground\">{stat.label}</h3>\n              {stat.description != null && <p className=\"mt-1 text-base text-pretty text-muted-foreground\">{stat.description}</p>}\n            </div>\n          </motion.li>\n        ))}\n      </ol>\n    </Tag>\n  )\n}\n"}],"usage":"<pre class=\"shiki shiki-themes github-light github-dark-default\" style=\"--shiki-light:#24292e;--shiki-dark:#e6edf3;--shiki-light-bg:#fff;--shiki-dark-bg:#0d1117\" tabindex=\"0\"><code><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> { StatsEditorialList } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\"> '@/components/stats-editorial-list'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">export</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> default</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> function</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#D2A8FF\"> StatsEditorialListDemo</span><span style=\"--shiki-light:#24292E;--shiki-dark:#FFA657\">() </span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">{</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">  return</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> (</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">    &#x3C;</span><span style=\"--shiki-light:#22863A;--shiki-dark:#7EE787\">div</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#79C0FF\"> className</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">=</span><span style=\"--shiki-light:#032F6