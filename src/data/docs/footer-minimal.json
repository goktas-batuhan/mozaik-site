{\n  label: string\n  href: string\n}\n\nexport interface FooterMinimalSocial {\n  /** Accessible name, also shown to screen readers. */\n  label: string\n  href: string\n  /** Inline SVG or any icon node. */\n  icon: ReactNode\n}\n\nexport interface FooterMinimalProps {\n  /** Logo or wordmark at the start. */\n  brand: ReactNode\n  /** Short text next to the brand. */\n  copyright?: ReactNode\n  links?: FooterMinimalLink[]\n  social?: FooterMinimalSocial[]\n  /** Turns the small lift on social icons off. */\n  disabled?: boolean\n  as?: ElementType\n  className?: string\n}\n\nconst linkClass =\n  'rounded-sm text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring'\n\n/** One-row footer: brand and copyright, a few links, social icons. Stacks on narrow containers. */\nexport function FooterMinimal({\n  brand,\n  copyright,\n  links = [],\n  social = [],\n  disabled = false,\n  as: Tag = 'footer',\n  className,\n}: FooterMinimalProps) {\n  const reduced = usePrefersReducedMotion()\n  const lift = !disabled && !reduced\n\n  return (\n    <Tag className={cn('@container w-full border-t border-border bg-background text-foreground', className)}>\n      <div className=\"mx-auto flex max-w-6xl flex-col items-center gap-5 px-6 py-6 @2xl:flex-row @2xl:justify-between\">\n        <div className=\"flex items-center gap-3\">\n          <span className=\"text-base font-semibold tracking-tight\">{brand}</span>\n          {copyright != null && (\n            <>\n              <span aria-hidden className=\"h-4 w-px bg-border\" />\n              <span className=\"text-sm text-muted-foreground\">{copyright}</span>\n            </>\n          )}\n        </div>\n        {links.length > 0 && (\n          <nav aria-label=\"Footer\">\n            <ul className=\"flex items-center gap-6\">\n              {links.map((link) => (\n                <li key={link.label}>\n                  <a href={link.href} className={linkClass}>\n                    {link.label}\n                  </a>\n                </li>\n              ))}\n            </ul>\n          </nav>\n        )}\n        {social.length > 0 && (\n          <ul className=\"flex items-center gap-4\">\n            {social.map((item) => (\n              <li key={item.label}>\n                <motion.a\n                  href={item.href}\n                  aria-label={item.label}\n                  whileHover={lift ? { y: -2 } : undefined}\n                  whileTap={lift ? { scale: 0.94 } : undefined}\n                  className=\"flex rounded-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring\"\n                >\n                  {item.icon}\n                </motion.a>\n              </li>\n            ))}\n          </ul>\n        )}\n      </div>\n    </Tag>\n  )\n}\n"}],"usage":"<pre class=\"shiki shiki-themes github-light github-dark-default\" style=\"--shiki-light:#24292e;--shiki-dark:#e6edf3;--shiki-light-bg:#fff;--shiki-dark-bg:#0d1117\" tabindex=\"0\"><code><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> { FooterMinimal } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\"> '@/components/footer-minimal'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">const</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#D2A8FF\"> icon</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> =</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> (</span><span style=\"--shiki-light:#E36209;--shiki-dark:#FFA657\">path</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">:</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79C