pan><span style=\"--shiki-light:#22863A;--shiki-dark:#7EE787\">li</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">></span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">            )</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">          })</span><span style=\"--shiki-light:#24292E;--shiki-dark:#FF7B72\">}</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">        &#x3C;/</span><span style=\"--shiki-light:#22863A;--shiki-dark:#7EE787\">ul</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">></span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">      &#x3C;/</span><span style=\"--shiki-light:#22863A;--shiki-dark:#7EE787\">div</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">></span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">    &#x3C;/</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#7EE787\">Tag</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">></span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">  )</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">}</span></span></code></pre>","raw":"import { motion, useReducedMotion, useReducedMotionConfig } from 'motion/react'\nimport { useId, type ElementType, type ReactNode } from 'react'\nimport { NumberTicker } from '@/components/number-ticker'\nimport { cn } from '@/lib/utils'\n\n/** OS setting, or forced on with <MotionConfig reducedMotion=\"always\">. */\nfunction usePrefersReducedMotion() {\n  const os = useReducedMotion()\n  const forced = useReducedMotionConfig()\n  return Boolean(os || forced)\n}\n\nexport interface BarStat {\n  /** What the bar measures. */\n  label: string\n  /** Percentage from 0 to 100. */\n  value: number\n  /** A short line under the bar. */\n  description?: string\n}\n\nexport interface StatsProgressBarsProps {\n  /** Section headline. Labels the section for assistive tech. */\n  title: ReactNode\n  /** Supporting copy under the headline. */\n  description?: ReactNode\n  /** Bars, top to bottom. */\n  stats: BarStat[]\n  /** Element for the root. */\n  as?: ElementType\n  /** Turns the entrance animation, the count-up and the bar fill off. */\n  disabled?: boolean\n  className?: string\n}\n\n/** Headline on the left, a stack of labelled bars on the right that fill to their percentage as they scroll into view. */\nexport function StatsProgressBars({ title, description, stats, as: Tag = 'section', disabled = false, className }: StatsProgressBarsProps) {\n  const id = useId()\n  const reduced = usePrefersReducedMotion()\n  const animate = !disabled && !reduced\n\n  return (\n    <Tag aria-labelledby={id} className={cn('@container w-full', className)}>\n      <div className=\"grid items-start gap-10 @3xl:grid-cols-[1fr_1.4fr] @3xl:gap-16\">\n        <div>\n          <h2 id={id} className=\"text-3xl font-semibold tracking-tight text-balance text-foreground @xl:text-4xl\">\n            {title}\n          </h2>\n          {description != null && <p className=\"mt-4 text-base text-pretty text-muted-foreground\">{description}</p>}\n        </div>\n\n        <ul className=\"space-y-7\">\n          {stats.map((stat, index) => {\n            const value = Math.min(Math.max(stat.value, 0), 100)\n            return (\n              <li key={stat.label}>\n                <div className=\"flex items-baseline justify-between gap-4\">\n                  <span id={`${id}-${index}`} className=\"text-base font-medium text-foreground\">\n                    {stat.label}\n                  </span>\n                  <span className=\"flex items-baseline text-2xl font-semibold tabular-nums text-foreground\">\n                    <NumberTicker value={value} duration={1.2} disabled={disabled} />%\n                  </span>\n                </div>\n                <div\n                  role=\"progressbar\"\n                  aria-labelledby={`${id}-${index}`}\n                  aria-valuemin={0}\n                  aria-valuemax={100}\n                  aria-valuenow={value}\n                  className=\"mt-3 h-2.5 overflow-hidden rounded-full bg-muted\"\n                >\n                  <motion.div\n                    initial={animate ? { width: 0 } : false}\n                    whileInView={{ width: `${value}%` }}\n                    viewport={{ once: true }}\n                    transition={{ duration: 1.2, delay: index * 0.1, ease: [0.22, 1, 0.36, 1] }}\n                    style={animate ? undefined : { width: `${value}%` }}\n                    className=\"h-full rounded-full bg-primary\"\n                  />\n                </div>\n                {stat.description != null && <p className=\"mt-2 text-sm text-muted-foreground\">{stat.description}</p>}\n              </li>\n            )\n          })}\n        </ul>\n      </div>\n    </Tag>\n  )\n}\n"}],"usage":"<pre class=\"shiki shiki-themes github-light github-dark-default\" style=\"--shiki-light:#24292e;--shiki-dark:#e6edf3;--shiki-light-bg:#fff;--shiki-dark-bg:#0d1117\" tabindex=\"0\"><code><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> { StatsProgressBars } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\"> '@/components/stats-progress-bars'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">export</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> default</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> function</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#D2A8FF\"> StatsProgressBarsDemo</spa