: 'Wed', value: 51 },\n  { label: 'Thu', value: 73 },\n  { label: 'Fri', value: 66 },\n  { label: 'Sat', value: 31 },\n  { label: 'Sun', value: 24 },\n]\n\nexport default function BarChartDemo() {\n  return (\n    <div className=\"w-[min(92vw,420px)]\">\n      <BarChart data={WEEK} label=\"Deploys this week\" showValues />\n    </div>\n  )\n}\n","variants":[]}