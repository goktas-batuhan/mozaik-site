on, useReducedMotionConfig } from 'motion/react'\nimport { useEffect, useState } from 'react'\nimport type { ComponentPropsWithoutRef, Ref } from 'react'\nimport { cn } from '@/lib/utils'\n\n/** OS setting, or forced on with <MotionConfig reducedMotion=\"always\">. */\nfunction usePrefersReducedMotion() {\n  const os = useReducedMotion()\n  const forced = useReducedMotionConfig()\n  return Boolean(os || forced)\n}\n\nconst HOVER_QUERY = '(hover: hover) and (pointer: fine)'\n\nexport interface DotMorphButtonProps extends ComponentPropsWithoutRef<'button'> {\n  /** Text next to the dot. */\n  label: string\n  ref?: Ref<HTMLButtonElement>\n}\n\n/** A pill button whose leading dot stretches into a bar on hover and focus. */\nexport function DotMorphButton({\n  label,\n  className,\n  type = 'button',\n  disabled,\n  ref,\n  onPointerEnter,\n  onPointerLeave,\n  onFocus,\n  onBlur,\n  ...props\n}: DotMorphButtonProps) {\n  const reduced = usePrefersReducedMotion()\n  const [hover, setHover] = useState(false)\n  const [focus, setFocus] = useState(false)\n  const [canHover, setCanHover] = useState(false)\n\n  useEffect(() => {\n    const query = window.matchMedia(HOVER_QUERY)\n    setCanHover(query.matches)\n    const onChange = (e: MediaQueryListEvent) => setCanHover(e.matches)\n    query.addEventListener('change', onChange)\n    return () => query.removeEventListener('change', onChange)\n  }, [])\n\n  const morphed = !reduced && !disabled && ((hover && canHover) || focus)\n\n  return (\n    <button\n      {...props}\n      ref={ref}\n      type={type}\n      disabled={disabled}\n      data-morphed={morphed || undefined}\n      onPointerEnter={(e) => {\n        setHover(true)\n        onPointerEnter?.(e)\n      }}\n      onPointerLeave={(e) => {\n        setHover(false)\n        onPointerLeave?.(e)\n      }}\n      onFocus={(e) => {\n        setFocus(e.currentTarget.matches(':focus-visible'))\n        onFocus?.(e)\n      }}\n      onBlur={(e) => {\n        setFocus(false)\n        onBlur?.(e)\n      }}\n      className={cn(\n        'inline-flex h-12 cursor-pointer items-center gap-3 rounded-full border border-border bg-background px-6 text-lg font-medium whitespace-nowrap text-foreground select-none',\n        'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring',\n        'disabled:pointer-events-none disabled:opacity-50',\n        className,\n      )}\n    >\n      <span aria-hidden className=\"flex h-7 w-4 items-center justify-center\">\n        <motion.span\n          data-slot=\"dot\"\n          className=\"block bg-primary\"\n          initial={false}\n          animate={morphed ? { width: 12, height: 28 } : { width: 16, height: 16 }}\n          style={{ borderRadius: 999 }}\n          transition={{ type: 'spring', stiffness: 600, damping: 22 }}\n        />\n      </span>\n      {label}\n    </button>\n  )\n}\n"}],"usage":"<pre class=\"shiki shiki-themes github-light github-dark-default\" style=\"--shiki-light:#24292e;--shiki-dark:#e6edf3;--shiki-light-bg:#fff;--shiki-dark-bg:#0d1117\" tabindex=\"0\"><code><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> { DotMorphButton, </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">type</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> DotMorphButtonProps } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\"> '@/components/dot-morph-button'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">export</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> default</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> function</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#D2A8FF\"> DotMorphButtonDemo</span><span style=\"--shiki-light:#24292E;