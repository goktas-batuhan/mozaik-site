ion: </span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\">'Measured over the last twelve months across every region.'</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> },</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">          { value: </span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\">'42ms'</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">, label: </span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\">'Median response'</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">, description: </span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\">'From the nearest edge location to your user.'</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> },</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">          { value: </span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\">'3x'</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">, label: </span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\">'Faster releases'</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">, description: </span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\">'Reported by teams after their first quarter.'</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> },</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">        ]</span><span style=\"--shiki-light:#24292E;--shiki-dark:#FF7B72\">}</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">      /></span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">    &#x3C;/</span><span style=\"--shiki-light:#22863A;--shiki-dark:#7EE787\">div</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">></span></span>\n<span class=\"line\"><span style=\"--shiki-light:#2429