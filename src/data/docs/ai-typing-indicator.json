Seconds for one bounce. */\n  duration?: number\n  /** Seconds between one dot and the next. */\n  delay?: number\n  /** Pauses the dots without hiding the indicator. */\n  paused?: boolean\n  className?: string\n}\n\n/** Three bouncing dots in a chat bubble that say someone is typing. */\nexport function AITypingIndicator({ name = 'Assistant', dots = 3, duration = 1, delay = 0.15, paused = false, className }: AITypingIndicatorProps) {\n  const reduced = usePrefersReducedMotion()\n  const still = reduced || paused\n\n  return (\n    <div\n      role=\"status\"\n      data-slot=\"ai-typing-indicator\"\n      className={cn('inline-flex h-9 items-center gap-1 rounded-2xl rounded-bl-md bg-muted px-3.5', className)}\n    >\n      <span className=\"sr-only\">{name} is typing</span>\n      {Array.from({ length: Math.max(1, dots) }, (_, i) => (\n        <motion.span\n          key={i}\n          aria-hidden\n          className=\"block size-1.5 rounded-full bg-muted-foreground\"\n          animate={still ? { y: 0, opacity: 0.6 } : { y: [0, -4, 0], opacity: [0.4, 1, 0.4] }}\n          transition={still ? { duration: 0 } : { duration, delay: i * delay, ease: 'easeInOut', repeat: Infinity }}\n        />\n      ))}\n    </div>\n  )\n}\n"}],"usage":"<pre class=\"shiki shiki-themes github-light github-dark-default\" style=\"--shiki-light:#24292e;--shiki-dark:#e6edf3;--shiki-light-bg:#fff;--shiki-dark-bg:#0d1117\" tabindex=\"0\"><code><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> { AITypingIndicator } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\"> '@/components/ai-typing-indicator'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">export</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> default</sp