dated today</span>\n        <a\n          href=\"#\"\n          className=\"inline-flex items-center gap-1 rounded-md text-sm font-medium text-foreground outline-none focus-visible:ring-2 focus-visible:ring-ring\"\n        >\n          Open <ArrowUpRight className=\"size-4\" aria-hidden />\n        </a>\n      </TextureCardFooter>\n    </TextureCard>\n  )\n}\n","variants":[]}