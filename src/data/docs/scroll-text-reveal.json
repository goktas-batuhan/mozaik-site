 [number, number]; still: boolean }) {\n  const opacity = useTransform(progress, range, [0, 1])\n  return (\n    <span aria-hidden className=\"relative inline-block whitespace-pre\">\n      <span className=\"opacity-20\">{word}</span>\n      <motion.span className=\"absolute inset-0\" style={{ opacity: still ? 1 : opacity }}>\n        {word}\n      </motion.span>\n    </span>\n  )\n}\n\n/** A paragraph whose words light up one by one as it scrolls up the screen. */\nexport function ScrollTextReveal({\n  text,\n  as: Tag = 'p',\n  offset = ['start 0.9', 'start 0.35'],\n  disabled = false,\n  className,\n}: ScrollTextRevealProps) {\n  const ref = useRef<HTMLElement>(null)\n  const reduced = usePrefersReducedMotion()\n  const { scrollYProgress } = useScroll({ target: ref, offset: offset as ['start end', 'end start'] })\n  const still = disabled || reduced\n  const words = text.split(/\\s+/).filter(Boolean)\n\n  return (\n    <Tag ref={ref} className={cn('text-foreground', className)}>\n      <span className=\"sr-only\">{text}</span>\n      {words.map((word, i) => (\n        <span key={i} aria-hidden>\n          <Word word={word} progress={scrollYProgress} range={[i / words.length, (i + 1) / words.length]} still={still} />\n          {i < words.length - 1 ? ' ' : null}\n        </span>\n      ))}\n    </Tag>\n  )\n}\n"}],"usage":"<pre class=\"shiki shiki-themes github-light github-dark-default\" style=\"--shiki-light:#24292e;--shiki-dark:#e6edf3;--shiki-light-bg:#fff;--shiki-dark-bg:#0d1117\" tabindex=\"0\"><code><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> { ScrollTextReveal } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\"> '@/components/scroll-text-reveal'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B