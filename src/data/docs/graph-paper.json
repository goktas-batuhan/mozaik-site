 backgroundImage: layers.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#D2A8FF\">join</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\">', '</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">),</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">        backgroundSize: sizes.</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#D2A8FF\">join</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">(</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\">', '</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">),</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">        maskImage: </span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79C0FF\">MASK</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">[fade],</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">        WebkitMaskImage: </span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79C0FF\">MASK</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">[fade],</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">      }</span><span style=\"--shiki-light:#24292E;--shiki-dark:#FF7B72\">}</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">    /></span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">  )</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">}</span></span></code></pre>","raw":"import { cn } from '@/lib/utils'\n\nexport type GraphPaperFade = 'none' | 'radial' | 'vertical'\n\nexport interface GraphPaperProps {\n  /** Size of one small square, in pixels. */\n  size?: number\n  /** Every n-th line is drawn stronger. Use 0 to draw only the small grid. */\n  majorEvery?: number\n  /** Fades the grid out towards the edges. */\n  fade?: GraphPaperFade\n  className?: string\n}\n\nconst MASK: Record<GraphPaperFade, string | undefined> = {\n  none: undefined,\n  radial: 'radial-gradient(ellipse at center, black 30%, transparent 75%)',\n  vertical: 'linear-gradient(to bottom, black 35%, transparent 100%)',\n}\n\nconst line = (percent: number) => `color-mix(in oklab, var(--foreground) ${percent}%, transparent)`\n\n/** Engineering graph paper: fine squares with a stronger line every few cells. Place it behind content. */\nexport function GraphPaper({ size = 24, majorEvery = 5, fade = 'radial', className }: GraphPaperProps) {\n  const major = size * majorEvery\n  const layers = [\n    `linear-gradient(to right, ${line(6)} 1px, transparent 1px)`,\n    `linear-gradient(to bottom, ${line(6)} 1px, transparent 1px)`,\n  ]\n  const sizes = [`${size}px ${size}px`, `${size}px ${size}px`]\n  if (majorEvery > 0) {\n    layers.unshift(\n      `linear-gradient(to right, ${line(12)} 1px, transparent 1px)`,\n      `linear-gradient(to bottom, ${line(12)} 1px, transparent 1px)`,\n    )\n    sizes.unshift(`${major}px ${major}px`, `${major}px ${major}px`)\n  }\n\n  return (\n    <div\n      aria-hidden\n      className={cn('pointer-events-none absolute inset-0', className)}\n      style={{\n        backgroundImage: layers.join(', '),\n        backgroundSize: sizes.join(', '),\n        maskImage: MASK[fade],\n        WebkitMaskImage: MASK[fade],\n      }}\n    />\n  )\n}\n"}],"usage":"<pre class=\"shiki shiki-themes github-light github-dark-default\" style=\"--shiki-light:#24292e;--shiki-dark:#e6edf3;--shiki-light-bg:#fff;--shiki-dark-bg:#0d1117\" tabindex=\"0\"><code><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> { GraphPaper } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">from</span><span style=\"--shiki-light:#03