dden [perspective:200px]', className)}\n    >\n      <div className=\"absolute inset-0\" style={{ transform: `rotateX(${angle}deg)` }}>\n        <motion.div\n          className=\"absolute -ml-[250%] w-[600%]\"\n          style={{\n            height: cellSize * CELLS,\n            backgroundImage: line,\n            backgroundSize: `${cellSize}px ${cellSize}px`,\n            y: '-25%',\n          }}\n          animate={reduced ? undefined : { y: ['-50%', '0%'] }}\n          transition={{ duration, ease: 'linear', repeat: Infinity }}\n        />\n      </div>\n      <div className=\"absolute inset-0 bg-linear-to-b from-background from-10% via-transparent via-50% to-background/50\" />\n    </div>\n  )\n}\n"}],"usage":"<pre class=\"shiki shiki-themes github-light github-dark-default\" style=\"--shiki-light:#24292e;--shiki-dark:#e6edf3;--shiki-light-bg:#fff;--shiki-dark-bg:#0d1117\" tabindex=\"0\"><code><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> { RetroGrid } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\"> '@/components/retro-grid'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">export</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> default</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> function</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#D2A8FF\"> RetroGridDemo</span><span style=\"--shiki-light:#24292E;--shiki-dark:#FFA657\">() </span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">{</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">  return</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> (</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E