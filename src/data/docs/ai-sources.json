DF3\">      &#x3C;</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#7EE787\">AISources</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#79C0FF\"> sources</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">=</span><span style=\"--shiki-light:#24292E;--shiki-dark:#FF7B72\">{</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#79C0FF\">SOURCES</span><span style=\"--shiki-light:#24292E;--shiki-dark:#FF7B72\">}</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#79C0FF\"> defaultOpen</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> /></span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">    &#x3C;/</span><span style=\"--shiki-light:#22863A;--shiki-dark:#7EE787\">div</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">></span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">  )</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">}</span></span></code></pre>","usageRaw":"import { AISources } from '@/components/ai-sources'\n\nconst SOURCES = [\n  { id: 'mdn', title: 'prefers-reduced-motion', url: 'https://developer.mozilla.org/en-US/docs/Web/CSS/@media/prefers-reduced-motion' },\n  { id: 'wcag', title: 'Understanding animation from interactions', url: 'https://www.w3.org/WAI/WCAG22/Understanding/animation-from-interactions.html', site: 'w3.org' },\n  { id: 'motion', title: 'Accessibility in Motion', url: 'https://motion.dev/docs/react-accessibility' },\n]\n\nexport default function AISourcesDemo() {\n  return (\n    <div className=\"w-[min(92vw,460px)]\">\n      <AISources sources={SOURCES} defaultOpen />\n    </div>\n  )\n}\n","variants":[]}