ucedMotionConfig } from 'motion/react'\nimport { useRef } from 'react'\nimport { cn } from '@/lib/utils'\n\n/** OS setting, or forced on with <MotionConfig reducedMotion=\"always\">. */\nfunction usePrefersReducedMotion() {\n  const os = useReducedMotion()\n  const forced = useReducedMotionConfig()\n  return Boolean(os || forced)\n}\n\n\nexport interface ShineTextProps {\n  /** The text to light up. */\n  children: string\n  /** Seconds one sweep takes. */\n  duration?: number\n  /** Seconds to rest between sweeps. */\n  delay?: number\n  /** Resting text color. Any CSS color; defaults to the muted token. */\n  baseColor?: string\n  /** Color of the moving highlight. Any CSS color; defaults to the foreground token. */\n  shineColor?: string\n  /** Turns the animation off and renders calm static text. */\n  disabled?: boolean\n  className?: string\n}\n\n/** A band of light glides across the text on a loop. */\nexport function ShineText({\n  children,\n  duration = 2.5,\n  delay = 0.6,\n  baseColor = 'var(--muted-foreground)',\n  shineColor = 'var(--foreground)',\n  disabled = false,\n  className,\n}: ShineTextProps) {\n  const ref = useRef<HTMLSpanElement>(null)\n  const reduced = usePrefersReducedMotion()\n  const inView = useInView(ref)\n\n  if (disabled || reduced) {\n    return (\n      <span ref={ref} className={className} style={{ color: baseColor }}>\n        {children}\n      </span>\n    )\n  }\n\n  return (\n    <motion.span\n      ref={ref}\n      className={cn('bg-clip-text text-transparent', className)}\n      style={{\n        backgroundImage: `linear-gradient(110deg, ${baseColor} 40%, ${shineColor} 50%, ${baseColor} 60%)`,\n        backgroundSize: '250% 100%',\n        WebkitTextFillColor: 'transparent',\n      }}\n      initial={{ backgroundPositionX: '150%' }}\n      animate={inView ? { backgroundPositionX: ['150%', '-150%'] } : { backgroundPositionX: '150%' }}\n      transition={{ duration, ease: 'linear', repeat: Infinity, repeatDelay: delay }}\n    >\n      {children}\n    </motion.span>\n  )\n}\n"}],"usage":"<pre class=\"shiki shiki-themes github-light github-dark-default\" style=\"--shiki-light:#24292e;--shiki-dark:#e6edf3;--shiki-light-bg:#fff;--shiki-dark-bg:#0d1117\" tabindex=\"0\"><code><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> { ShineText } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\"> '@/components/shine-text'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">export</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> default</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> function</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#D2A8FF\"> ShineTextDemo</span><span style=\"--shiki-light:#24292E;--shiki-dark:#FFA657\">() </span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">{</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">  return</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> (</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">    &#x3C;</span><span style=\"--shiki-light:#22863A;--shiki-dark:#7EE787\">div</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#79C0FF\"> className</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">=</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\">\"flex flex-col items-center gap-5 text-center\"</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">></span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">      &#x3C;</span><span style=\"--shiki-light:#005CC5;--shiki-dark:#7EE787\">ShineText</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#79C0FF\"> cl