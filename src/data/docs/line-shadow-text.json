ce-pre text-transparent [background-clip:text] [-webkit-background-clip:text] [background-image:linear-gradient(45deg,transparent_45%,var(--shadow-color)_45%,var(--shadow-color)_55%,transparent_0)]\"\n        style={{ backgroundSize: `${STRIPE}em ${STRIPE}em` }}\n        initial={{ backgroundPosition: '0em 0em' }}\n        animate={still || !inView ? { backgroundPosition: '0em 0em' } : { backgroundPosition: [`0em 0em`, `${STRIPE}em ${-STRIPE}em`] }}\n        transition={still ? { duration: 0 } : { duration, ease: 'linear', repeat: Infinity }}\n      >\n        {text}\n      </motion.span>\n    </Tag>\n  )\n}\n"}],"usage":"<pre class=\"shiki shiki-themes github-light github-dark-default\" style=\"--shiki-light:#24292e;--shiki-dark:#e6edf3;--shiki-light-bg:#fff;--shiki-dark-bg:#0d1117\" tabindex=\"0\"><code><span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">import</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> { LineShadowText } </span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">from</span><span style=\"--shiki-light:#032F62;--shiki-dark:#A5D6FF\"> '@/components/line-shadow-text'</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">export</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> default</span><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\"> function</span><span style=\"--shiki-light:#6F42C1;--shiki-dark:#D2A8FF\"> LineShadowTextDemo</span><span style=\"--shiki-light:#24292E;--shiki-dark:#FFA657\">() </span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">{</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#D73A49;--shiki-dark:#FF7B72\">  return</span><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\"> (</span></span>\n<span class=\"line\"><span style=\"--shiki-light:#24292E;--shiki-dark:#E6EDF3\">    &#x3C;</span><span style=\"--shiki-light:#22863A;--shiki-dark:#7EE787